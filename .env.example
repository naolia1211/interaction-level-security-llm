# --- Option 1: Anthropic API directly (LiteLLM reads this variable automatically)
ANTHROPIC_API_KEY=

# --- Option 2: through a gateway (company LLM proxy / Anthropic-compatible endpoint)
# Fill both; they are passed to LiteLLM as api_base / api_key.
# If the gateway is OpenAI-compatible, also change the model prefix below to "openai/<model-name-on-gateway>".
LLM_API_BASE=
LLM_API_KEY=

# Models (LiteLLM names). Agent = system under test, User = customer / attacker simulator.
AGENT_MODEL=anthropic/claude-haiku-5-5
USER_MODEL=anthropic/claude-sonnet-5-5
